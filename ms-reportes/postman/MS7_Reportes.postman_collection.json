        "body": {
          "mode": "raw",
          "raw": "{\n  \"servicio\": \"ms-ordenes\",\n  \"metodo\": \"DELETE\",\n  \"ruta\": \"/ordenes/1\",\n  \"ruta_plantilla\": \"/ordenes/{id_orden}\",\n  \"codigo_estado\": 200\n}"
