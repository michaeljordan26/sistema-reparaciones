            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
