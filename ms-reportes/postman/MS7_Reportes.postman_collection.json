          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Hay operaciones registradas\", () => pm.expect(pm.response.json().total_operaciones > 0).to.be.true);",
