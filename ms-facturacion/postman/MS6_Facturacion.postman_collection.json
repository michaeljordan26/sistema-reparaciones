        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_orden\": \"{{id_orden}}\",\n  \"mano_obra\": [\n    {\n      \"descripcion\": \"Limpieza interna y cambio de pasta térmica\",\n      \"horas\": 1,\n      \"valor_hora\": 40000\n    },\n    {\n      \"descripcion\": \"Instalación de memoria y pruebas\",\n      \"horas\": 0.5,\n      \"valor_hora\": 40000\n    }\n  ],\n  \"repuestos\": [\n    {\n      \"id_repuesto\": 1,\n      \"cantidad\": 1\n    }\n  ],\n  \"observaciones\": \"Válido por 15 días\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"id_presupuesto\", pm.response.json().id_presupuesto);",
              "const p = pm.response.json();",
              "pm.test(\"Mano de obra = 60.000\", () => pm.expect(p.subtotal_mano_obra).to.eql(60000));",
              "pm.test(\"Materiales = precio de la RAM\", () => pm.expect(p.subtotal_materiales).to.eql(130000));",
              "pm.test(\"Total = subtotal + IVA 19%\", () => pm.expect(p.total).to.eql(p.subtotal + p.iva));"
            ]
          }
        }
      ]
    },
