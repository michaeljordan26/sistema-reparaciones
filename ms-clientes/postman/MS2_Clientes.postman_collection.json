{
  "info": {
    "name": "MS2 - Clientes y Equipos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8002"
    },
    {
      "key": "auth_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "id_cliente",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login recepcionista en MS1 (guarda token)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{auth_url}}/auth/login",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "recepcion"
            },
            {
              "key": "password",
              "value": "Recepcion123*"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Registrar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/clientes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"1098765432\",\n  \"nombres\": \"Camila\",\n  \"apellidos\": \"Vargas\",\n  \"telefono\": \"3157778899\",\n  \"correo\": \"camila@correo.com\",\n  \"direccion\": \"Calle 100 # 15-20\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"id_cliente\", pm.response.json().id_cliente);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Cliente duplicado (debe dar 409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/clientes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"1098765432\",\n  \"nombres\": \"Camila\",\n  \"apellidos\": \"Vargas\",\n  \"telefono\": \"3157778899\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Buscar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/clientes?buscar=vargas",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "clientes"
          ],
          "query": [
            {
              "key": "buscar",
              "value": "vargas"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Actualizar cliente",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/clientes/{{id_cliente}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "clientes",
            "{{id_cliente}}"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"telefono\": \"3159990000\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Registrar equipo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/equipos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "equipos"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_cliente\": \"{{id_cliente}}\",\n  \"tipo_equipo\": \"PORTATIL\",\n  \"marca\": \"Asus\",\n  \"modelo\": \"VivoBook 15\",\n  \"numero_serie\": \"ASUS15SN001\",\n  \"descripcion\": \"Teclado no responde\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Equipos del cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/clientes/{{id_cliente}}/equipos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "clientes",
            "{{id_cliente}}",
            "equipos"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Buscar equipo por serie",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/equipos?numero_serie=ASUS",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "equipos"
          ],
          "query": [
            {
              "key": "numero_serie",
              "value": "ASUS"
            }
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Detalle del equipo 1 con su cliente",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/equipos/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "equipos",
            "1"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Login técnico en MS1 (guarda token)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{auth_url}}/auth/login",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "username",
              "value": "tecnico1"
            },
            {
              "key": "password",
              "value": "Tecnico123*"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Técnico intenta registrar cliente (debe dar 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/clientes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tipo_documento\": \"CC\",\n  \"numero_documento\": \"11111111\",\n  \"nombres\": \"No\",\n  \"apellidos\": \"Permitido\",\n  \"telefono\": \"3000000000\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Técnico sí puede consultar clientes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/clientes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "clientes"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}