        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"CABLE-HDMI-2M\",\n  \"nombre\": \"Cable HDMI 2 metros\",\n  \"categoria\": \"cables\",\n  \"marca\": \"Genérico\",\n  \"precio_costo\": 8000,\n  \"precio_venta\": 18000,\n  \"stock_minimo\": 2,\n  \"stock_inicial\": 3\n}"
