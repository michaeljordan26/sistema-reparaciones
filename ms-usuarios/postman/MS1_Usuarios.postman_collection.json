              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_usuario\": \"{{nuevo_id}}\",\n  \"especialidad\": \"Impresoras\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
