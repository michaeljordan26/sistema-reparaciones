          }
        }
      ]
    },
    {
      "name": "10 Asignar roles al usuario 2",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/usuarios/2/roles",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "usuarios",
            "2",
            "roles"
