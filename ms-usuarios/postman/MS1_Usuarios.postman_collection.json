            "{{base_url}}"
          ],
          "path": [
            "roles"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Listar usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/usuarios",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Crear usuario técnico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/usuarios",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Pedro\",\n  \"apellidos\": \"López\",\n  \"correo\": \"pedro@taller.com\",\n  \"nombre_usuario\": \"pedro\",\n  \"contrasena\": \"Pedro1234*\",\n  \"roles\": [\n    \"TECNICO\"\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"nuevo_id\", pm.response.json().id_usuario);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Crear perfil técnico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tecnicos",
          "host": [
