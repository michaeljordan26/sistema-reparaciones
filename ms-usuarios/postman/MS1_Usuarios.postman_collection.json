            ]
          }
        }
      ]
    },
    {
      "name": "09 Actualizar técnico 1",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/tecnicos/1",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "tecnicos",
            "1"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado_laboral\": \"VACACIONES\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Código 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "09b Devolver técnico 1 a ACTIVO (lo necesita el MS3)",
      "request": {
